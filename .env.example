# Configuração do MedIA Briefing. Copie para .env e edite (ou rode node scripts/init-env.ts, que gera o .env com chaves aleatórias).
# O front-end só recebe o endereço do site; todas as chaves ficam no back-end. Não faça commit do .env no Git.

# ===== Obrigatório =====

# Endereço público do site: usado nos links gerados, no RSS, nas imagens de compartilhamento e no MCP. Para testar localmente, use este.
SITE_URL=http://localhost:3000

# Senha de administrador (pelo menos 12 caracteres), para entrar em /admin.
ADMIN_PASSWORD=

# Chaves de assinatura da sessão e do proxy de imagens: uma sequência aleatória cada (pode gerar com openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Senha do banco de dados ao usar Docker (o banco não expõe porta; use caracteres aleatórios também).
POSTGRES_PASSWORD=

# Modelo: qualquer API compatível com OpenAI; todas as etapas usam este por padrão. Abaixo, a configuração da DeepSeek.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parâmetros de requisição específicos do fornecedor (JSON), por exemplo para desligar o modo de raciocínio:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Exemplos de outros fornecedores:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Ative se o modelo lê imagens (título e resumo da Seleção passam a considerar a primeira imagem):
# LLM_VISION=true
# Desative se o serviço não suporta modo JSON (response_format):
# LLM_JSON_MODE=false
# Cota extra de saída reservada ao raciocínio em modelos que pensam antes de responder (raciocínio e resposta dividem a cota),
# somada à cota de cada etapa; vazio = 0. Defina quando aparecer "output token limit reached (finish_reason=length)", por exemplo:
# LLM_REASONING_TOKENS=4000

# ===== Opcional: agrupamento de eventos mais preciso =====

# Recuperação vetorial: qualquer endpoint /embeddings compatível com OpenAI. Funciona sem ele: o agrupamento passa a buscar
# candidatos por sobreposição de texto, mas a maioria dos posts que só servem de evidência de repercussão (fontes hot_signal)
# não se liga a eventos, e o índice Em alta fica mais baixo.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Ou preencha só a chave do Alibaba Cloud Model Studio (Bailian) para usar text-embedding-v4:
# DASHSCOPE_API_KEY=
# Dimensão dos vetores (com EMBEDDING_* o padrão é a que o serviço devolver; Bailian usa 1024); ao mudar, os vetores antigos são recalculados:
# EMBEDDING_DIMS=

# ===== Opcional: um modelo diferente por etapa =====
# Por padrão todas as etapas usam o LLM_* acima. Para uma etapa usar outro fornecedor, informe o nome do preset (com a chave correspondente):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Presets e chaves necessárias:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Atenção: com DASHSCOPE_API_KEY preenchida e EMBEDDING_API_KEY vazia, o agrupamento usa automaticamente os vetores do Bailian (text-embedding-v4), cobrados à parte pelo preço do Bailian.

# ===== Opcional: serviços pagos de coleta (cobrados por requisição, com limite de orçamento ajustável em "Configurações" no Painel) =====
# Contas do X (Twitter): SocialData
# SOCIALDATA_API_KEY=
# Contas do WeChat: Dajiala
# DAJIALA_KEY=
# Renderização em navegador quando o corpo não é coletado: Jina Reader
# JINA_API_KEY=
# Instagram (módulo instagram: hashtags e perfis de industry/instagram.json, a cada 6 horas): ScrapeCreators.
# A coleta só roda com esta válvula e COLLECT_ENABLED em true, e com a chave preenchida (veja docs/fontes.md, Redes sociais):
INSTAGRAM_COLLECT_ENABLED=false
# SCRAPECREATORS_API_KEY=
# Endereço da API da ScrapeCreators, só para testes locais:
# SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# ===== Artigos científicos (módulo literatura: buscas no PubMed, acesso aberto legal, matérias) =====
# E-mail de contato enviado ao PubMed (NCBI) e ao Unpaywall; sem ele o Unpaywall não é consultado e só se usa o PMC:
LITERATURA_EMAIL=
# Chave gratuita do NCBI: 10 requisições por segundo em vez de 3 (https://www.ncbi.nlm.nih.gov/account/):
# NCBI_API_KEY=
# Republicar traduções de artigos com licença CC BY-NC (só se o site não tiver fins comerciais); CC BY-ND nunca é republicada:
# LITERATURA_ALLOW_NC=false
# Modelo da etapa que escreve a matéria sobre cada artigo (padrão: o mesmo LLM_MODEL):
# MATERIA_MODEL=
# Modelo da etapa que escreve o especial Linha do tempo a partir dos estudos do PubMed (padrão: o mesmo LLM_MODEL):
# LINHA_DO_TEMPO_MODEL=
# Endereços dos serviços, só para testes locais:
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# ICITE_BASE_URL=https://icite.od.nih.gov/api
# UNPAYWALL_BASE_URL=https://api.unpaywall.org/v2
# EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
# CROSSREF_BASE_URL=https://api.crossref.org
# CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# OPENFDA_BASE_URL=https://api.fda.gov
# ANVISA_BASE_URL=https://www.gov.br/anvisa/++api++

# ===== Assinatura da edição semanal (módulo assinatura, página /assine; veja docs/assinatura.md) =====
# E-mail pela API do Resend: confirmação da inscrição e a edição de cada segunda. O remetente precisa ser de um domínio verificado no Resend.
NEWSLETTER_EMAIL_ENABLED=false
# RESEND_API_KEY=
# NEWSLETTER_FROM=O Fôlego <edicao@seudominio.com>
# Segredo de assinatura do webhook do Resend (whsec_..., eventos email.bounced e email.complained): devoluções e reclamações
# no Painel → Inscritos; uma reclamação tira o endereço da lista. Sem ele, o webhook recusa tudo e o painel não as conta:
# RESEND_WEBHOOK_SECRET=
# WhatsApp por uma instância da Evolution API (endereço do servidor, chave e nome da instância). O leitor se inscreve mandando
# "QUERO O FÔLEGO" para o número do jornal (o botão da página /assine abre o WhatsApp com essa mensagem); sem o número, o canal fica fechado:
NEWSLETTER_WHATSAPP_ENABLED=false
# Só dígitos, com o código do país (sem +, espaços nem traços); outro formato deixa o canal fechado e o Painel → Inscritos diz por quê:
# NEWSLETTER_WHATSAPP_NUMBER=5511987654321
# EVOLUTION_API_URL=https://evolution.seudominio.com
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# Segredo do webhook que recebe as mensagens da Evolution (QUERO O FÔLEGO inscreve, SAIR/PARAR descadastram); sem ele o webhook recusa tudo:
# EVOLUTION_WEBHOOK_SECRET=
# Endereço da API do Resend, só para testes locais:
# RESEND_BASE_URL=https://api.resend.com

# ===== Opcional: Feishu =====
# Envio da Seleção para grupos do Feishu (só a Seleção de fontes T1 e T1_5): ative em "Configurações → Destinos de notificação" no Painel e informe o webhook aqui.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alertas e encaminhamento de feedback para um grupo interno do Feishu (requer um app próprio do Feishu):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Entrar no Painel com conta do Feishu (opcional, convive com a senha de administrador):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Opcional: outros =====
# Fontes JSON que leem a API do GitHub (api.github.com) ganham cota maior com isto. Gratuito no GitHub, só com permissão de leitura:
# GITHUB_TOKEN=
# Token para scripts externos enviarem conteúdo ao site (POST /api/ingest/items), pelo menos 16 caracteres; vazio desativa o endpoint.
# INGEST_TOKEN=
# Quantos envios por minuto cada cliente pode fazer (docker compose usa 10 por padrão); se um proxy reverso à frente já limita, pode ser 0:
# INGEST_RATE_LIMIT=10
# Quando a coleta de fontes precisa passar por um proxy (por exemplo, servidor com saída restrita):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Limite de tráfego do proxy de imagens ao buscar na origem (MB por minuto, GB por dia); acima dele, imagens fora do cache recebem 503.
# Vazio segue DEPLOYMENT.imageUpstreamBudget em site/site.ts, que por padrão não tem limite:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Defina como true quando houver um proxy reverso como Caddy ou Nginx à frente, para o endereço do visitante vir do X-Forwarded-For;
# com o site exposto diretamente, mantenha false, para ninguém forjar o endereço e contornar os limites de login e de feedback.
TRUST_PROXY=false
# O MCP só aceita requisições para o domínio de SITE_URL (e localhost); se houver outros domínios de acesso, liste aqui separados por vírgula:
# MCP_ALLOWED_HOSTS=
# Quantos minutos sem conteúdo novo contam como "parou de receber artigos" e geram alerta; vazio segue ALERTS.quietMinutes em site/site.ts (padrão 360):
# ALERT_QUIET_MINUTES=360
# Envia as páginas novas ao IndexNow (Bing etc.) todo dia; a chave tem 32 dígitos hexadecimais, gere a sua:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Backup diário do banco de dados para um armazenamento de objetos compatível com S3 (Tencent Cloud COS, AWS S3, Alibaba Cloud OSS…).
# Sem DB_BACKUP_STORE_DOMAIN, o endereço é montado no formato do Tencent Cloud COS (<bucket>.cos.<região>.myqcloud.com);
# com outro fornecedor, informe o domínio de acesso com o bucket, por exemplo para AWS S3: my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Nível de log (padrão info) e limite do pool de conexões do banco (padrão 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Nome da versão: aparece na página "Execução" do Painel e em /api/health, para confirmar que o processo foi trocado após uma atualização:
# AIHOT_RELEASE=
# Nome do ambiente; por padrão production ou development conforme NODE_ENV. Fora de production os alertas o mencionam,
# e o acesso ao Painel sem login em desenvolvimento só funciona fora de production:
# AIHOT_ENVIRONMENT=
# Guarde as chaves por grupo em um diretório (models.env, collectors.env, integrations.env, auth.env) em vez de aqui; o que estiver aqui tem prioridade:
# AIHOT_CREDENTIALS_DIR=

# ===== Válvulas de segurança =====
# Só com true as fontes são coletadas (inclusive os ícones das fontes, uma vez por dia) e os modelos são chamados;
# apague estas duas linhas ou mude para false para parar tudo (útil ao depurar a interface).
# Todos os interruptores *_ENABLED deste arquivo só aceitam true; 1, yes ou TRUE contam como desligado.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Só ao rodar direto na máquina, sem Docker =====
# DATABASE_URL=postgres://usuario@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# Diretório para arquivos enviados, cache de imagens e backups locais (padrão: .data no repositório):
# AIHOT_DATA_DIR=/var/lib/myhot
# Entrar no Painel sem login durante o desenvolvimento (em produção o processo se recusa a iniciar) e o nome exibido no Painel:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Permitir coletar endereços da rede interna ao depurar localmente (proibido por padrão; em produção o processo se recusa a iniciar):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== Ao usar docker compose --profile https =====
# SITE_DOMAIN=example.com
# Porta local do site (usada pelo docker compose, padrão 3000, acessível em todas as interfaces); com HTTPS, só para o Caddy local, sem exposição direta:
# PORT=127.0.0.1:3000
# Mude também o TRUST_PROXY acima para true.
